Dialogue: 0,0:00:00.00,0:00:00.74,Cap,,0,0,0,,ME AND MY KID
Dialogue: 0,0:00:00.74,0:00:01.78,Cap,,0,0,0,,ARE REBOOTING THE JAWS
Dialogue: 0,0:00:01.78,0:00:02.14,Cap,,0,0,0,,SERIES.
Dialogue: 0,0:00:02.32,0:00:03.16,Cap,,0,0,0,,HERE'S EVERY PLOT FROM
Dialogue: 0,0:00:03.16,0:00:04.18,Cap,,0,0,0,,JAWS 5 TO JAWS
Dialogue: 0,0:00:04.18,0:00:04.54,Cap,,0,0,0,,10.
Dialogue: 0,0:00:04.88,0:00:05.66,Cap,,0,0,0,,WE'RE GONNA START WITH
Dialogue: 0,0:00:05.66,0:00:06.70,Cap,,0,0,0,,JAWS 5 AND LET'S
Dialogue: 0,0:00:06.70,0:00:07.76,Cap,,0,0,0,,JUST PRETEND JAWS 3
Dialogue: 0,0:00:07.76,0:00:08.80,Cap,,0,0,0,,AND 4 NEVER HAPPENED.
Dialogue: 0,0:00:09.18,0:00:10.00,Cap,,0,0,0,,WE OPEN ON AMITY
Dialogue: 0,0:00:10.00,0:00:10.34,Cap,,0,0,0,,ISLAND.
Dialogue: 0,0:00:10.52,0:00:11.84,Cap,,0,0,0,,A STEAMSHIP AUTHORITY FERRY
Dialogue: 0,0:00:11.84,0:00:12.92,Cap,,0,0,0,,GETS RAMMED BY A
Dialogue: 0,0:00:12.92,0:00:14.02,Cap,,0,0,0,,SHARK AND STARTS SINKING.
Dialogue: 0,0:00:14.54,0:00:15.40,Cap,,0,0,0,,PEOPLE HIT THE WATER
Dialogue: 0,0:00:15.40,0:00:16.18,Cap,,0,0,0,,AND A WHOLE SWARM
Dialogue: 0,0:00:16.18,0:00:17.16,Cap,,0,0,0,,OF GREAT WHITE SHARKS
Dialogue: 0,0:00:17.16,0:00:18.32,Cap,,0,0,0,,START GOBBLING THEM UP.
Dialogue: 0,0:00:18.52,0:00:20.30,Cap,,0,0,0,,IT'S FRIGGIN' SHARK 911.
Dialogue: 0,0:00:20.76,0:00:21.74,Cap,,0,0,0,,POLICE CHIEF BRODY,
Dialogue: 0,0:00:22.14,0:00:23.00,Cap,,0,0,0,,STILL ALIVE AND PLAYED
Dialogue: 0,0:00:23.00,0:00:24.12,Cap,,0,0,0,,BY PEDRO PASCAL,
Dialogue: 0,0:00:24.42,0:00:25.34,Cap,,0,0,0,,ROUNDS UP EVERY BOAT
Dialogue: 0,0:00:25.34,0:00:26.14,Cap,,0,0,0,,IN THE HARBOR LIKE
Dialogue: 0,0:00:26.14,0:00:27.48,Cap,,0,0,0,,IT'S THE FRIGGIN' EVACUATION
Dialogue: 0,0:00:27.48,0:00:28.22,Cap,,0,0,0,,AT DUNKIRK.
Dialogue: 0,0:00:28.44,0:00:29.16,Cap,,0,0,0,,MOST OF THEM GET
Dialogue: 0,0:00:29.16,0:00:29.90,Cap,,0,0,0,,RAMMED AND SUNK.
Dialogue: 0,0:00:29.90,0:00:30.86,Cap,,0,0,0,,ONLY A FEW PEOPLE
Dialogue: 0,0:00:30.86,0:00:31.77,Cap,,0,0,0,,MAKE IT BACK AND
Dialogue: 0,0:00:31.77,0:00:32.70,Cap,,0,0,0,,STORIES ARE HARROWING.
Dialogue: 0,0:00:33.02,0:00:34.10,Cap,,0,0,0,,IT MAKES NATIONAL NEWS
Dialogue: 0,0:00:34.10,0:00:35.04,Cap,,0,0,0,,AND BRINGS IN CHIEF
Dialogue: 0,0:00:35.04,0:00:36.32,Cap,,0,0,0,,OCEANOGRAPHER JESSE,
Dialogue: 0,0:00:36.60,0:00:37.66,Cap,,0,0,0,,PLAYED BY JESSE PLEMONS,
Dialogue: 0,0:00:37.68,0:00:38.40,Cap,,0,0,0,,WHO WEARS A STEVE
Dialogue: 0,0:00:38.40,0:00:39.58,Cap,,0,0,0,,ZISSOU RED CAP EVEN
Dialogue: 0,0:00:39.58,0:00:40.42,Cap,,0,0,0,,THOUGH IT'S SUMMERTIME.
Dialogue: 0,0:00:40.52,0:00:41.54,Cap,,0,0,0,,HE BRINGS AN ADVANCED
Dialogue: 0,0:00:41.54,0:00:42.76,Cap,,0,0,0,,RADAR THAT SHOWS THE
Dialogue: 0,0:00:42.76,0:00:43.68,Cap,,0,0,0,,SHARKS MOVING IN A
Dialogue: 0,0:00:43.68,0:00:44.30,Cap,,0,0,0,,STRAIGHT LINE.
Dialogue: 0,0:00:44.66,0:00:45.82,Cap,,0,0,0,,SO POLICE CHIEF BRODY
Dialogue: 0,0:00:45.82,0:00:47.08,Cap,,0,0,0,,BUILDS A MECHANICAL SHARK
Dialogue: 0,0:00:47.08,0:00:47.66,Cap,,0,0,0,,SUBMARINE,
Dialogue: 0,0:00:47.86,0:00:48.50,Cap,,0,0,0,,BLENDS IN,
Dialogue: 0,0:00:48.60,0:00:49.62,Cap,,0,0,0,,AND FOLLOWS THE SHARKS
Dialogue: 0,0:00:49.62,0:00:50.82,Cap,,0,0,0,,TO A GIANT UNDERWATER
Dialogue: 0,0:00:50.82,0:00:52.58,Cap,,0,0,0,,CAVE RIGHT UNDERNEATH THE
Dialogue: 0,0:00:52.58,0:00:54.02,Cap,,0,0,0,,FLYING HORSES CAROUSEL.
Dialogue: 0,0:00:54.28,0:00:55.26,Cap,,0,0,0,,THEY HATCH A PLAN,
Dialogue: 0,0:00:55.44,0:00:56.50,Cap,,0,0,0,,LURE ALL THE SHARKS
Dialogue: 0,0:00:56.50,0:00:57.24,Cap,,0,0,0,,IN WITH BAIT,
Dialogue: 0,0:00:57.50,0:00:58.24,Cap,,0,0,0,,WHICH IS THROWN UP
Dialogue: 0,0:00:58.24,0:00:59.38,Cap,,0,0,0,,BY THE MECHANICAL SHARK
Dialogue: 0,0:00:59.38,0:00:59.98,Cap,,0,0,0,,SUBMARINE,
Dialogue: 0,0:01:00.22,0:01:01.02,Cap,,0,0,0,,BLOW UP THE CAVE
Dialogue: 0,0:01:01.02,0:01:01.44,Cap,,0,0,0,,ENTRANCE,
Dialogue: 0,0:01:01.82,0:01:02.52,Cap,,0,0,0,,THEN KICK THE KIDS
Dialogue: 0,0:01:02.52,0:01:03.46,Cap,,0,0,0,,OFF THE CAROUSEL,
Dialogue: 0,0:01:03.76,0:01:04.70,Cap,,0,0,0,,DRILL STRAIGHT DOWN AND
Dialogue: 0,0:01:04.70,0:01:05.56,Cap,,0,0,0,,PUMP ALL THE WATER
Dialogue: 0,0:01:05.56,0:01:05.86,Cap,,0,0,0,,OUT.
Dialogue: 0,0:01:06.12,0:01:07.28,Cap,,0,0,0,,IT'S A CRAZY PLAN,
Dialogue: 0,0:01:07.52,0:01:08.60,Cap,,0,0,0,,BUT JUST CRAZY ENOUGH
Dialogue: 0,0:01:08.60,0:01:09.08,Cap,,0,0,0,,TO WORK.
Dialogue: 0,0:01:09.42,0:01:10.54,Cap,,0,0,0,,POLICE CHIEF BRODY AND
Dialogue: 0,0:01:10.54,0:01:11.82,Cap,,0,0,0,,JESSE SAVE THE DAY.
Dialogue: 0,0:01:12.04,0:01:13.28,Cap,,0,0,0,,THE RADAR GOES QUIET.
Dialogue: 0,0:01:13.76,0:01:14.00,Cap,,0,0,0,,THEN,
Dialogue: 0,0:01:14.38,0:01:15.00,Cap,,0,0,0,,ALL OF A SUDDEN,
Dialogue: 0,0:01:15.42,0:01:15.72,Cap,,0,0,0,,BEEP,
Dialogue: 0,0:01:16.08,0:01:16.64,Cap,,0,0,0,,BEEP,
Dialogue: 0,0:01:16.80,0:01:17.56,Cap,,0,0,0,,BEEP,
Dialogue: 0,0:01:17.72,0:01:18.94,Cap,,0,0,0,,ANOTHER LINE OF SHARKS,
Dialogue: 0,0:01:19.20,0:01:20.44,Cap,,0,0,0,,HEADED STRAIGHT FOR EDGARTOWN
Dialogue: 0,0:01:20.44,0:01:20.80,Cap,,0,0,0,,HARBOR.
Dialogue: 0,0:01:21.12,0:01:22.04,Cap,,0,0,0,,AND THAT LEADS US
Dialogue: 0,0:01:22.04,0:01:22.98,Cap,,0,0,0,,TO JAWS 6.
